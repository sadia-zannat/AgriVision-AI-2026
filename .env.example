# Copy this file to .env in this same folder. Keep credentials private.
DEFAULT_MODEL=hybrid
INFERENCE_DEVICE=auto
DETECTION_MIN_SCORE=0.40
MIN_MODEL_SCORE=0.75
MIN_SCORE_MARGIN=0.15
MAX_RECORD_SECONDS=120
STORAGE_BUDGET_MB=1024
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Set offline for a completely local Plant Doctor.
CHAT_PROVIDER_ORDER=meta,gemini,groq,ollama,offline
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Optional: absolute path to your backed-up previous evidence directory.
# APP_DATA_DIR=C:/AgriVisionPrevious/artifacts
